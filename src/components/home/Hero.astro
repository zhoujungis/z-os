---
import Icon from '../common/Icon.astro';
import { getCopy } from '../../i18n/ui';
import { formatDate, localizePath } from '../../i18n';
import type { Lang } from '../../types/domain';

interface Props {
  lang: Lang;
  appCount: number;
  familyCount: number;
  starCount: number;
  latestRelease?: {
    name: string;
    tag: string;
    publishedAt: string;
    url: string;
    cover?: string;
    accent: string;
  };
  recent: Array<{ name: string; family: string; href: string; updatedAt: string; accent: string }>;
}
const { lang, appCount, familyCount, starCount, latestRelease, recent } = Astro.props;
const copy = getCopy(lang);
const format = (value: string) =>
  formatDate(value, lang, { month: 'short', day: '2-digit', year: 'numeric' });
---

<section class="hero site-container">
  <div class="hero-copy" data-reveal>
    <p class="eyebrow">{copy.home.eyebrow}</p>
    <h1>
      {copy.home.heroLine1}
      <br />
      {copy.home.heroLine2}
      {lang === 'en' ? ' ' : ''}
      <em>{copy.home.heroEm}</em>
    </h1>
    <p class="hero-lede">
      {copy.home.heroLede}
      {lang === 'en' ? ' ' : ''}
      <strong>{copy.home.heroLedeStrong}</strong>
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={localizePath('/projects', lang)}>
        {copy.home.exploreApps}
        <Icon name="arrow-right" size={17} />
      </a>
      <a class="button button-secondary" href={localizePath('/about', lang)}>
        {copy.home.developerLink}
        <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
    <dl class="hero-stats">
      <div>
        <dt>{copy.home.statApplications}</dt>
        <dd>{String(appCount).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.home.statFamilies}</dt>
        <dd>{String(familyCount).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.home.statStars}</dt>
        <dd>{starCount}</dd>
      </div>
    </dl>
  </div>

  <div class="hero-panel-wrap" data-reveal style="--reveal-delay:120ms">
    <aside class="hero-panel" aria-label={copy.home.panelAria}>
      {latestRelease ? (
        <a
          class="latest-release"
          href={latestRelease.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="latest-cover" aria-hidden="true">
            {latestRelease.cover ? (
              <img
                src={latestRelease.cover}
                alt=""
                width="176"
                height="110"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span
                class="latest-cover-fallback"
                style={`--project-accent:${latestRelease.accent}`}
              >
                {latestRelease.name.slice(0, 1)}
              </span>
            )}
          </span>
          <span class="latest-copy">
            <span class="panel-label mono">{copy.home.panelLatest}</span>
            <strong>{latestRelease.name}</strong>
            <small class="mono">
              {latestRelease.tag} · {format(latestRelease.publishedAt)}
            </small>
          </span>
          <span class="latest-arrow">
            <Icon name="arrow-up-right" size={16} />
          </span>
        </a>
      ) : (
        <p class="panel-empty">{copy.home.panelEmpty}</p>
      )}
      <div class="panel-recent">
        <div class="panel-label-row">
          <span class="panel-label mono">{copy.home.panelRecent}</span>
        </div>
        {recent.map((item) => (
          <a
            class="recent-row"
            href={localizePath(`/projects/${item.href}`, lang)}
            style={`--project-accent:${item.accent}`}
          >
            <span class="recent-dot" aria-hidden="true"></span>
            <span class="recent-name">{item.name}</span>
            <span class="recent-family mono">{item.family}</span>
            <time class="mono" datetime={item.updatedAt}>
              {format(item.updatedAt)}
            </time>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
    gap: clamp(2rem, 3.4vw, 3rem);
    align-items: center;
    padding-block: clamp(1.9rem, 2.8vw, 2.6rem) clamp(1.55rem, 2.2vw, 1.95rem);
  }
  h1 {
    max-width: 700px;
    margin: 0.6rem 0 0.8rem;
    font-size: clamp(2.45rem, 4.2vw, 4.1rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }
  h1:lang(zh) {
    line-height: 1.14;
    letter-spacing: -0.018em;
  }
  h1 em {
    color: var(--z-primary);
    font-style: normal;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .hero-lede {
    max-width: 560px;
    margin: 0;
    color: var(--z-text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
  }
  .hero-lede strong {
    color: var(--z-text);
    font-weight: 560;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.1rem;
  }
  .hero-stats {
    display: flex;
    gap: 0;
    margin: 1.15rem 0 0;
    padding: 0;
  }
  .hero-stats div {
    display: grid;
    gap: 0.1rem;
    padding-right: 1.25rem;
    margin-right: 1.25rem;
    border-right: 1px solid var(--z-border);
  }
  .hero-stats div:last-child {
    padding-right: 0;
    margin-right: 0;
    border-right: 0;
  }
  .hero-stats dt {
    order: 2;
    color: var(--z-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hero-stats dd {
    order: 1;
    margin: 0;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .hero-panel-wrap {
    position: relative;
  }
  .hero-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--z-border-strong);
    border-radius: 4px;
    background: var(--z-surface);
  }
  .hero-panel::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    content: '';
    background: var(--z-primary);
  }
  .latest-release {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 0.75rem;
    align-items: center;
    margin: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--z-border);
    border-radius: 2px;
    transition:
      border-color 200ms ease,
      background 200ms ease;
  }
  .latest-release:hover {
    border-color: var(--z-border-strong);
    background: var(--z-surface-soft);
  }
  .latest-cover {
    display: block;
    width: 72px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--z-surface-raised);
  }
  .latest-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .latest-cover-fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background: color-mix(in srgb, var(--project-accent) 20%, var(--z-surface-raised));
    color: var(--z-text);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .latest-copy {
    display: grid;
    min-width: 0;
    gap: 0.14rem;
  }
  .latest-copy strong {
    overflow: hidden;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .latest-copy small {
    overflow: hidden;
    color: var(--z-text-muted);
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .panel-label {
    color: var(--z-text-muted);
    font-size: 0.72rem;
  }
  .latest-arrow {
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    place-items: center;
    border: 1px solid var(--z-border);
    border-radius: 2px;
    color: var(--z-text-muted);
  }
  .latest-release:hover .latest-arrow {
    color: var(--z-primary);
  }
  .panel-recent {
    display: grid;
    padding: 0.85rem 1rem 0.95rem;
  }
  .panel-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--z-border);
  }
  .recent-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.55rem 0.1rem;
    border-bottom: 1px solid var(--z-border);
    color: var(--z-text-secondary);
    font-size: 0.84rem;
    transition: color 160ms ease;
  }
  .recent-row:hover {
    color: var(--z-text);
  }
  .recent-dot {
    width: 0.34rem;
    height: 0.34rem;
    background: var(--project-accent);
  }
  .recent-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .recent-family {
    color: var(--z-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .recent-row time {
    color: var(--z-text-muted);
    font-size: 0.7rem;
  }
  .panel-empty {
    padding: 2rem 1.25rem;
    color: var(--z-text-muted);
    font-size: 0.9rem;
  }
  @media (max-width: 1040px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-block: 2.1rem 1.75rem;
    }
    .hero-panel-wrap {
      width: min(100%, 520px);
    }
    h1 {
      font-size: clamp(2.5rem, 6.8vw, 3.9rem);
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-block: 1.75rem 1.5rem;
      gap: 1.5rem;
    }
    h1 {
      margin-block: 0.55rem 0.75rem;
      font-size: clamp(2.2rem, 10.8vw, 3.05rem);
      line-height: 1.08;
    }
    h1:lang(zh) {
      line-height: 1.18;
    }
    .hero-lede {
      font-size: 0.94rem;
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .hero-stats {
      margin-top: 1.15rem;
    }
    .hero-stats div {
      padding-right: 1.1rem;
      margin-right: 1.1rem;
    }
    .hero-stats dd {
      font-size: 1.4rem;
    }
    .latest-release {
      grid-template-columns: 68px 1fr auto;
    }
    .latest-cover {
      width: 68px;
    }
    .recent-family {
      display: none;
    }
    .recent-row {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>
