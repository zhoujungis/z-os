---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import { getDisciplines, site } from '../config/site';
import { getFamilies, getFamily } from '../config/families';
import { getGitHubSnapshot, getProjects } from '../utils/projects';
import { getServiceMetrics } from '../utils/status';
import { getCopy } from '../i18n/ui';
import { formatDate, localizePath } from '../i18n';
import statusData from '../data/status.json';
import type { Lang, StatusSnapshot } from '../types/domain';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = getCopy(lang);
const projects = await getProjects(lang);
const representatives = projects.filter((project) => project.data.featured);
const released = projects.filter((project) => project.data.status === 'released').length;
const github = getGitHubSnapshot();
const starCount = github.repositories.reduce((total, repo) => total + (repo.stars ?? 0), 0);
const status = statusData as unknown as StatusSnapshot;
const liveSurfaces = status.services.filter(
  (service) => getServiceMetrics(service).status !== 'outage',
).length;
const families = getFamilies(lang);
const familyIndex = families.map((family) => ({
  ...family,
  count: projects.filter((project) => project.data.series === family.key).length,
}));
const updatedAt = github.lastSuccessfulAt
  ? formatDate(github.lastSuccessfulAt, lang, { year: 'numeric', month: 'short' })
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'ZhouJun',
  url: site.url,
  sameAs: [site.github, site.blog],
  jobTitle: copy.about.roleValue,
  knowsAbout: getDisciplines(lang),
};
---

<BaseLayout
  lang={lang}
  title={copy.pageTitles.about}
  description={copy.seo.aboutDescription}
  jsonLd={jsonLd}
>
  <header class="about-hero site-container">
    <div class="about-intro" data-reveal>
      <p class="eyebrow">{copy.about.eyebrow}</p>
      <h1>
        {copy.about.titleLine1}
        <br />
        <em>{copy.about.titleEm}</em>
      </h1>
      <p>{copy.about.intro}</p>
      <div class="about-actions">
        <a
          class="button button-primary"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} /> {copy.about.follow}
        </a>
        <a class="text-link" href={site.blog} target="_blank" rel="noopener noreferrer">
          {copy.about.blog} <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>
    <aside class="identity-card" aria-label={copy.about.identityAria}>
      <div class="identity-top">
        <span class="identity-mark">Z</span>
        <span class="identity-code mono">Z-OS</span>
      </div>
      <dl class="identity-lines mono">
        <div>
          <dt>{copy.about.roleLabel}</dt>
          <dd>{copy.about.roleValue}</dd>
        </div>
        <div>
          <dt>{copy.about.focusLabel}</dt>
          <dd>{copy.about.focusValue}</dd>
        </div>
        <div>
          <dt>{copy.about.modeLabel}</dt>
          <dd>{copy.about.modeValue}</dd>
        </div>
      </dl>
      <div class="identity-foot mono">
        <span>{copy.about.snapshot}</span>
        <span>{updatedAt ?? copy.about.syncPending}</span>
      </div>
    </aside>
  </header>

  <section class="site-container about-stats-wrap" aria-label={copy.about.snapshot}>
    <dl class="about-stats" data-reveal>
      <div>
        <dt>{copy.about.statsApplications}</dt>
        <dd>{String(projects.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.about.statsFamilies}</dt>
        <dd>{String(families.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.about.statsReleased}</dt>
        <dd>{String(released).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.about.statsStars}</dt>
        <dd>{String(starCount).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>{copy.about.statsLive}</dt>
        <dd>{String(liveSurfaces).padStart(2, '0')}</dd>
      </div>
    </dl>
  </section>

  <section class="section-compact site-container manifesto" data-reveal>
    <p class="eyebrow">{copy.about.manifestoEyebrow}</p>
    <blockquote>
      {copy.about.quoteLine1}
      <br />
      {copy.about.quoteLine2}
    </blockquote>
    <div class="manifesto-row">
      <p>{copy.about.manifestoRow}</p>
      <a class="text-link" href={site.blog} target="_blank" rel="noopener noreferrer">
        {copy.about.visitBlog} <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </section>

  <section class="section site-container">
    <SectionHeading eyebrow={copy.about.buildEyebrow} title={copy.about.buildTitle} lang={lang} />
    <div class="principles-grid">
      <article data-reveal style="--reveal-delay:0ms">
        <span class="mono principle-index">{copy.about.principle1Index}</span>
        <h2>{copy.about.principle1Title}</h2>
        <p>{copy.about.principle1Body}</p>
      </article>
      <article data-reveal style="--reveal-delay:70ms">
        <span class="mono principle-index">{copy.about.principle2Index}</span>
        <h2>{copy.about.principle2Title}</h2>
        <p>{copy.about.principle2Body}</p>
      </article>
      <article data-reveal style="--reveal-delay:140ms">
        <span class="mono principle-index">{copy.about.principle3Index}</span>
        <h2>{copy.about.principle3Title}</h2>
        <p>{copy.about.principle3Body}</p>
      </article>
    </div>
  </section>

  <section class="section-compact site-container family-map">
    <SectionHeading
      eyebrow={copy.about.familyEyebrow}
      title={copy.about.familyTitle}
      description={copy.about.familyDescription}
      lang={lang}
    />
    <div class="family-row" data-reveal>
      {familyIndex.map((family) => (
        <a
          href={localizePath(`/projects?family=${family.key}`, lang)}
          style={`--project-accent:${family.color}`}
          aria-label={`${family.label}, ${family.count} ${copy.about.familyAriaSuffix}`}
        >
          <span class="family-code">{family.label}</span>
          <strong>{String(family.count).padStart(2, '0')}</strong>
          <span class="mono family-row-note">{family.tagline}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section site-container">
    <SectionHeading
      eyebrow={copy.about.workEyebrow}
      title={copy.about.workTitle}
      href={localizePath('/projects', lang)}
      linkLabel={`${copy.common.allApplicationsBefore} ${projects.length} ${copy.common.allApplicationsAfter}`}
      lang={lang}
    />
    <div class="representative-list">
      {representatives.map((project) => (
        <a
          href={localizePath(`/projects/${project.id}`, lang)}
          style={`--project-accent:${project.data.accent}`}
        >
          <span class="rep-logo">
            {project.data.logo ? (
              <img src={project.data.logo} alt="" width="64" height="64" loading="lazy" />
            ) : (
              project.data.name.slice(0, 1)
            )}
          </span>
          <strong>{project.data.name}</strong>
          <p>{project.data.tagline}</p>
          <span class="pill pill-accent">{getFamily(project.data.series, lang).label}</span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      ))}
    </div>
  </section>

  <section class="section-compact site-container">
    <div class="about-cta" data-reveal>
      <div>
        <p class="eyebrow">{copy.about.ctaEyebrow}</p>
        <h2>
          {copy.about.ctaTitleLine1}
          <br />
          <em>{copy.about.ctaTitleEm}</em>
        </h2>
      </div>
      <div class="about-cta-actions">
        <a
          class="button button-primary"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.about.ctaGithub} <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="button button-secondary" href={localizePath('/projects', lang)}>
          {copy.about.ctaAll} <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(1.75rem, 3.2vw, 3.2rem);
    align-items: center;
    padding-block: clamp(2rem, 3.2vw, 2.7rem) 1.6rem;
    border-bottom: 1px solid var(--z-border);
  }
  .about-intro h1 {
    margin: 0.55rem 0 0.75rem;
    font-size: clamp(2.3rem, 4.4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .about-intro h1:lang(zh) {
    line-height: 1.14;
    letter-spacing: -0.015em;
  }
  .about-intro h1 em {
    color: var(--z-primary);
    font-style: normal;
    font-weight: 600;
  }
  .about-intro > p:not(.eyebrow) {
    max-width: 600px;
    color: var(--z-text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
  }
  .about-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.1rem;
  }
  .identity-card {
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-surface);
  }
  .identity-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: 108px;
    padding: 0.85rem;
    border-bottom: 1px solid var(--z-border);
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0 31px,
        color-mix(in srgb, var(--z-border) 60%, transparent) 31px 32px
      ),
      var(--z-surface-raised);
  }
  .identity-mark {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: var(--z-radius-sm);
    background: var(--z-primary);
    color: var(--z-primary-ink);
    font-size: 2rem;
    font-weight: 650;
    line-height: 1;
  }
  .identity-code {
    padding-bottom: 0.2rem;
    color: var(--z-text-muted);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }
  .identity-lines {
    margin: 0;
    padding: 0.4rem 1.05rem;
  }
  .identity-lines div {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0.7rem;
    padding-block: 0.65rem;
  }
  .identity-lines div + div {
    border-top: 1px solid var(--z-border);
  }
  .identity-lines dt {
    color: var(--z-text-muted);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }
  .identity-lines dd {
    margin: 0;
    color: var(--z-text-secondary);
    font-size: 0.68rem;
  }
  .identity-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.05rem;
    border-top: 1px solid var(--z-border);
    color: var(--z-text-muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }
  .about-stats-wrap {
    padding-top: 0.9rem;
  }
  .about-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-border);
  }
  .about-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 0.95rem;
    background: var(--z-surface);
  }
  .about-stats dt {
    color: var(--z-text-muted);
    font-family: var(--font-body);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .about-stats dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .manifesto blockquote {
    max-width: 780px;
    margin: 0.85rem 0 1.05rem;
    font-family: var(--font-body);
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.035em;
  }
  .manifesto-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 1.6rem;
  }
  .manifesto-row p {
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.92rem;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .principles-grid article {
    padding: 1.05rem;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-surface);
    transition: border-color 240ms ease;
  }
  .principles-grid article:hover {
    border-color: var(--z-border-strong);
  }
  .principle-index {
    color: var(--z-text-muted);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .principles-grid h2 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .principles-grid p {
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .family-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-border);
  }
  .family-row a {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem;
    background: var(--z-surface);
    transition: background 220ms ease;
  }
  .family-row a:hover {
    background: var(--z-surface-raised);
  }
  .family-row strong {
    font-family: var(--font-body);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  .family-row-note {
    overflow: hidden;
    color: var(--z-text-muted);
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .representative-list {
    border-top: 1px solid var(--z-border);
  }
  .representative-list > a {
    display: grid;
    grid-template-columns: 2.7rem max-content minmax(0, 1fr) auto auto;
    gap: 0.8rem;
    align-items: center;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--z-border);
    border-radius: var(--z-radius-sm);
    transition: background 200ms ease;
  }
  .representative-list > a:hover {
    background: var(--z-surface-soft);
  }
  .rep-logo {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--project-accent) 26%, var(--z-border));
    border-radius: var(--z-radius-sm);
    background: color-mix(in srgb, var(--project-accent) 8%, var(--z-surface-raised));
    color: var(--project-accent-text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .rep-logo img {
    width: 100%;
    height: 100%;
    padding: 0.5rem;
    object-fit: contain;
  }
  .representative-list strong {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .representative-list p {
    margin: 0;
    overflow: hidden;
    color: var(--z-text-muted);
    font-size: 0.86rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .representative-list > a > svg {
    color: var(--z-text-muted);
  }
  .representative-list a:hover strong,
  .representative-list a:hover > svg {
    color: var(--z-primary);
  }
  .about-cta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.1rem;
    padding: clamp(1.1rem, 2.2vw, 1.7rem);
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-surface);
  }
  .about-cta::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 64px;
    height: 3px;
    content: '';
    background: var(--z-primary);
  }
  .about-cta h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.7rem, 2.7vw, 2.35rem);
  }
  .about-cta h2 em {
    color: var(--z-primary);
    font-style: normal;
    font-weight: 600;
  }
  .about-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  @media (max-width: 1000px) {
    .about-hero {
      grid-template-columns: 1fr;
    }
    .identity-card {
      max-width: 480px;
    }
    .about-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .family-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .representative-list > a {
      grid-template-columns: 2.6rem 1fr auto;
    }
    .representative-list p {
      grid-column: 2 / -1;
      grid-row: 2;
      white-space: normal;
    }
    .representative-list .pill {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .about-hero {
      padding-block: 2.25rem;
      gap: 1.75rem;
    }
    .about-intro h1 {
      font-size: 2.5rem;
    }
    .about-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .identity-top {
      height: 118px;
    }
    .about-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-stats div:last-child {
      grid-column: span 2;
    }
    .family-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .manifesto blockquote br {
      display: none;
    }
    .about-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
