---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/common/EmptyState.astro';
import StatusBadge from '../components/common/StatusBadge.astro';
import Icon from '../components/common/Icon.astro';
import statusData from '../data/status.json';
import type { Lang, StatusSnapshot } from '../types/domain';
import { getServiceMetrics } from '../utils/status';
import { getTools } from '../utils/tools';
import { getProjects } from '../utils/projects';
import { getCopy } from '../i18n/ui';
import { formatDate, localizePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = getCopy(lang);
const status = statusData as unknown as StatusSnapshot;
const [toolEntries, projects] = await Promise.all([getTools(lang), getProjects(lang)]);
const tools = toolEntries.map((tool) => {
  const project = projects.find((entry) => entry.id === tool.projectSlug);
  const service = tool.serviceId
    ? status.services.find((item) => item.id === tool.serviceId)
    : undefined;
  return {
    ...tool,
    cover: project?.data.cover,
    accent: project?.data.accent ?? '#5eead4',
    domain: new URL(tool.url).hostname.replace(/^www\./, ''),
    projectHref: project ? localizePath(`/projects/${project.id}`, lang) : undefined,
    metrics: service ? getServiceMetrics(service) : null,
  };
});
const categories = new Set(tools.map((tool) => tool.category)).size;
const sources = tools.filter((tool) => tool.sourceUrl).length;
const probeAt = status.services
  .map((service) => service.checkedAt)
  .filter((value): value is string => Boolean(value))
  .sort()
  .at(-1);
const probeLabel = probeAt
  ? formatDate(probeAt, lang, {
      month: 'short',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    })
  : null;
---

<BaseLayout lang={lang} title={copy.pageTitles.tools} description={copy.seo.toolsDescription}>
  <header class="page-hero site-container">
    <div>
      <p class="eyebrow">{copy.tools.eyebrow}</p>
      <h1>
        {copy.tools.titleLine1}
        <br />
        <em>{copy.tools.titleEm}</em>
      </h1>
    </div>
    <p>
      {copy.tools.bodyPrefix} {tools.length} {copy.tools.bodyMiddle}
      {copy.tools.bodySuffix}
    </p>
  </header>

  <section class="site-container tools-index" aria-label={copy.tools.projectDetails}>
    <div class="tools-index-bar" data-reveal>
      <div class="tools-index-cell">
        <span class="mono">{copy.tools.indexProducts}</span>
        <strong>{String(tools.length).padStart(2, '0')}</strong>
      </div>
      <div class="tools-index-cell">
        <span class="mono">{copy.tools.indexCategories}</span>
        <strong>{String(categories).padStart(2, '0')}</strong>
      </div>
      <div class="tools-index-cell">
        <span class="mono">{copy.tools.indexOpenSource}</span>
        <strong>{String(sources).padStart(2, '0')}</strong>
      </div>
      <div class="tools-index-note">
        <Icon name="clock" size={15} />
        <span class="mono">
          {probeLabel ? `${copy.tools.lastProbe} ${probeLabel} UTC` : copy.tools.probePending}
        </span>
        <span class="mono">{copy.tools.observed}</span>
        <a href={localizePath('/status', lang)}>
          {copy.tools.fullStatus} <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>
  </section>

  <section class="site-container section-compact">
    {tools.length ? (
      <div class="tools-grid">
        {tools.map((tool, index) => (
          <article
            class:list={['card', 'tool-card', { 'tool-card-feature': index === 0 }]}
            style={`--project-accent:${tool.accent}`}
            data-reveal
          >
            <div class="tool-visual">
              {tool.cover ? (
                <img
                  src={tool.cover}
                  alt={`${tool.name} ${copy.common.previewSuffix}`}
                  width="1280"
                  height="800"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <div class="tool-art" aria-hidden="true">
                  <span>{tool.name.slice(0, 1)}</span>
                </div>
              )}
              <div class="tool-visual-meta">
                {tool.metrics && tool.metrics.status !== 'unknown' && (
                  <StatusBadge status={tool.metrics.status} lang={lang} />
                )}
              </div>
            </div>
            <div class="tool-body">
              <div class="tool-kicker">
                <span>{tool.category}</span>
              </div>
              <h2>{tool.name}</h2>
              <p>{tool.description}</p>
              <p class="tool-domain mono">{tool.domain}</p>
              <div class="tool-actions">
                <a
                  class:list={['button', index === 0 ? 'button-primary' : 'button-secondary']}
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {copy.tools.openProduct}
                  <Icon name="arrow-up-right" size={16} />
                </a>
                {tool.sourceUrl && (
                  <a
                    class="icon-button"
                    href={tool.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${tool.name} ${copy.common.sourceSuffix}`}
                  >
                    <Icon name="github" size={19} />
                  </a>
                )}
                {tool.projectHref && (
                  <a class="tool-detail-link" href={tool.projectHref}>
                    {copy.tools.projectDetails}
                    <Icon name="arrow-right" size={14} />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState
        title={copy.tools.emptyTitle}
        description={copy.tools.emptyDescription}
        href={localizePath('/projects', lang)}
        linkLabel={copy.tools.emptyLink}
      />
    )}
  </section>

  <section class="site-container section-compact">
    <div class="tools-note" data-reveal>
      <Icon name="clock" size={18} />
      <p>
        <strong>{copy.tools.noteTitle}</strong> {copy.tools.noteBody}
      </p>
      <a class="text-link" href={localizePath('/status', lang)}>
        {copy.tools.noteLink} <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-index {
    padding-top: 0.9rem;
  }
  .tools-index-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 0.5fr)) minmax(0, 1.5fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-border);
  }
  .tools-index-cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.8rem 0.95rem;
    background: var(--z-surface);
  }
  .tools-index-cell span {
    color: var(--z-text-muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }
  .tools-index-cell strong {
    font-size: 1.55rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tools-index-note {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    padding: 0.8rem 0.95rem;
    background: var(--z-surface);
    color: var(--z-text-muted);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
  }
  .tools-index-note a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    color: var(--z-primary);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .tool-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    transition: border-color 240ms ease;
  }
  .tool-card:hover,
  .tool-card:focus-within {
    border-color: color-mix(in srgb, var(--project-accent) 42%, var(--z-border));
  }
  .tool-card-feature {
    grid-column: span 2;
    flex-direction: row;
  }
  .tool-visual {
    position: relative;
    aspect-ratio: 16 / 9;
    flex: 1;
    overflow: hidden;
    border-bottom: 1px solid var(--z-border);
    background: var(--z-surface-raised);
  }
  .tool-card-feature .tool-visual {
    aspect-ratio: auto;
    min-height: 300px;
    border-right: 1px solid var(--z-border);
    border-bottom: 0;
  }
  .tool-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tool-art {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 200px;
    place-items: center;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0 35px,
        color-mix(in srgb, var(--z-border) 55%, transparent) 35px 36px
      ),
      var(--z-surface-raised);
    color: color-mix(in srgb, var(--project-accent) 72%, var(--z-text));
    font-size: 5rem;
    font-weight: 650;
  }
  .tool-visual-meta {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    left: 0.7rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .tool-visual-meta :global(.status-badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--z-radius-sm);
    background: rgba(5, 9, 16, 0.74);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tool-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.95rem;
  }
  .tool-card-feature .tool-body {
    flex: 0 0 46%;
    justify-content: center;
    padding: clamp(1rem, 2vw, 1.5rem);
  }
  .tool-kicker {
    margin-bottom: 0.7rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--z-border);
    color: var(--z-text-muted);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .tool-body h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .tool-body p {
    max-width: 520px;
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .tool-body .tool-domain {
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--project-accent) 22%, var(--z-text-secondary));
    font-size: 0.66rem;
    letter-spacing: 0.05em;
  }
  .tool-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 0.95rem;
  }
  .tool-detail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: var(--z-text-muted);
    font-size: 0.76rem;
  }
  .tool-detail-link:hover {
    color: var(--z-primary);
  }
  .tools-note {
    display: flex;
    align-items: start;
    gap: 0.9rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    color: var(--z-text-muted);
  }
  .tools-note svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--z-primary);
  }
  .tools-note p {
    max-width: 760px;
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.65;
  }
  .tools-note strong {
    color: var(--z-text-secondary);
  }
  .tools-note a {
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .tools-index-bar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tools-index-note {
      grid-column: 1 / -1;
    }
    .tools-index-note a {
      margin-left: 0;
    }
    .tool-card-feature {
      flex-direction: column;
    }
    .tool-card-feature .tool-visual {
      aspect-ratio: 16 / 9;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--z-border);
    }
    .tool-card-feature .tool-body {
      flex: 1;
    }
  }
  @media (max-width: 650px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
    .tool-card-feature {
      grid-column: auto;
    }
    .tools-index-bar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tools-index-cell {
      padding: 0.8rem;
    }
    .tools-note {
      flex-wrap: wrap;
    }
    .tools-note a {
      margin-left: 2rem;
    }
    .tool-actions .button {
      flex: 1 1 auto;
    }
    .tool-detail-link {
      margin-left: 0;
    }
  }
</style>
