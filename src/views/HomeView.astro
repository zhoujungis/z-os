---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ActivityList from '../components/activity/ActivityList.astro';
import StatusBadge from '../components/common/StatusBadge.astro';
import Icon from '../components/common/Icon.astro';
import EmptyState from '../components/common/EmptyState.astro';
import { getGitHubSnapshot, getRepository, getProjects } from '../utils/projects';
import { getActivity } from '../utils/activity';
import { getServiceMetrics } from '../utils/status';
import { getFamilies } from '../config/families';
import { getSiteDescription, site } from '../config/site';
import { getCopy } from '../i18n/ui';
import { formatDate, localizePath } from '../i18n';
import statusData from '../data/status.json';
import type { Lang, StatusSnapshot } from '../types/domain';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = getCopy(lang);
const description = getSiteDescription(lang);
const projects = await getProjects(lang);
const featured = projects.filter((project) => project.data.featured);
const activity = (await getActivity(lang)).slice(0, 6);
const github = getGitHubSnapshot();
const statusSnapshot = statusData as unknown as StatusSnapshot;

const familyIndex = getFamilies(lang).map((family) => ({
  ...family,
  count: projects.filter((project) => project.data.series === family.key).length,
}));

const starCount = github.repositories.reduce((total, repo) => total + (repo.stars ?? 0), 0);

const releases = projects
  .flatMap((project) => {
    const repo = getRepository(project.data.repository);
    return repo?.latestRelease ? [{ project, repo, release: repo.latestRelease }] : [];
  })
  .sort((a, b) => Date.parse(b.release.publishedAt) - Date.parse(a.release.publishedAt));

const latest = releases[0];
const latestRelease = latest
  ? {
      name: latest.project.data.name,
      tag: latest.release.tag,
      publishedAt: latest.release.publishedAt,
      url: latest.release.url,
      cover: latest.project.data.cover,
      accent: latest.project.data.accent,
    }
  : undefined;

const recent = projects
  .flatMap((project) => {
    const repo = getRepository(project.data.repository);
    return repo?.pushedAt
      ? [
          {
            name: project.data.name,
            family: project.data.series,
            href: project.id,
            updatedAt: repo.pushedAt,
            accent: project.data.accent,
          },
        ]
      : [];
  })
  .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt))
  .slice(0, 3);

const surfaces = statusSnapshot.services.map((service) => {
  const metrics = getServiceMetrics(service);
  return {
    id: service.id,
    name: service.name,
    url: service.url,
    domain: new URL(service.url).hostname.replace(/^www\./, ''),
    status: metrics.status,
  };
});
const probeAt = statusSnapshot.services
  .map((service) => service.checkedAt)
  .filter((value): value is string => Boolean(value))
  .sort()
  .at(-1);
const probeLabel = probeAt
  ? formatDate(probeAt, lang, {
      month: 'short',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    })
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description,
  author: { '@type': 'Person', name: 'ZhouJun', url: site.github },
};
---

<BaseLayout lang={lang} title={copy.pageTitles.home} description={description} jsonLd={jsonLd}>
  <Hero
    lang={lang}
    appCount={projects.length}
    familyCount={familyIndex.length}
    starCount={starCount}
    latestRelease={latestRelease}
    recent={recent}
  />

  <section class="section-compact site-container" aria-labelledby="families-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.home.familyEyebrow}</p>
        <h2 id="families-title">{copy.home.familyTitle}</h2>
      </div>
      <p class="family-note">{copy.home.familyNote}</p>
    </div>
    <div class="family-strip" data-reveal>
      {familyIndex.map((family) => (
        <a
          class="family-cell"
          href={localizePath(`/projects?family=${family.key}`, lang)}
          style={`--project-accent:${family.color}`}
        >
          <span class="family-cell-top">
            <span class="family-code">{family.code}</span>
            <span class="family-count mono">{String(family.count).padStart(2, '0')}</span>
          </span>
          <span class="family-name">{family.label}</span>
          <span class="family-tagline">{family.description}</span>
          <span class="family-cell-foot">
            <Icon name="arrow-up-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section site-container" aria-labelledby="featured-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.home.featuredEyebrow}</p>
        <h2 id="featured-title">{copy.home.featuredTitle}</h2>
        <p>{copy.home.featuredDescription}</p>
      </div>
      <a class="text-link" href={localizePath('/projects', lang)}>
        {copy.home.featuredLink}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="bento-grid">
      {featured.map((project, index) => (
        <div class="bento-item" data-reveal style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}>
          <ProjectCard project={project} lang={lang} eager={index < 2} />
        </div>
      ))}
    </div>
  </section>

  <section class="section-compact site-container" aria-labelledby="surfaces-title">
    <div class="surface-panel" data-reveal>
      <div class="surface-intro">
        <p class="eyebrow">{copy.home.surfacesEyebrow}</p>
        <h2 id="surfaces-title">{copy.home.surfacesTitle}</h2>
        <p>{copy.home.surfacesDescription}</p>
        <div class="surface-meta mono">
          {probeLabel && (
            <span>
              {copy.home.surfacesProbe} · {probeLabel} UTC
            </span>
          )}
          <a href={localizePath('/status', lang)}>
            {copy.home.surfacesStatus} <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </div>
      <div class="surface-grid">
        {surfaces.map((surface) => (
          <a class="surface-card" href={surface.url} target="_blank" rel="noopener noreferrer">
            <span class="surface-name-row">
              <span class="surface-name">{surface.name}</span>
              <span class="surface-arrow">
                <Icon name="arrow-up-right" size={15} />
              </span>
            </span>
            <span class="surface-domain mono">{surface.domain}</span>
            {surface.status !== 'unknown' && (
              <span class="surface-state">
                <StatusBadge status={surface.status} lang={lang} />
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section site-container build-section" aria-labelledby="build-title">
    <div class="build-layout">
      <div class="build-intro" data-reveal>
        <p class="eyebrow">{copy.home.buildEyebrow}</p>
        <h2 id="build-title">
          {copy.home.buildTitle1}
          <br />
          {copy.home.buildTitle2}
        </h2>
        <p>{copy.home.buildDescription}</p>
        <a class="button button-secondary" href={localizePath('/activity', lang)}>
          {copy.home.buildButton}
          <Icon name="arrow-right" size={16} />
        </a>
        <div class="build-note mono">
          <span>{copy.home.buildSnapshot}</span>
          <time datetime={github.lastSuccessfulAt ?? ''}>
            {github.lastSuccessfulAt
              ? formatDate(github.lastSuccessfulAt, lang, {
                  month: 'short',
                  day: '2-digit',
                  year: 'numeric',
                })
              : copy.home.buildUnknown}
          </time>
        </div>
      </div>
      <div class="build-log" data-reveal>
        <div class="log-header mono">
          <span>{copy.home.activityHead}</span>
          <span>
            {copy.home.activityLast} {String(activity.length).padStart(2, '0')}
          </span>
        </div>
        {activity.length ? (
          <ActivityList items={activity} lang={lang} />
        ) : (
          <EmptyState
            title={copy.home.emptyTitle}
            description={copy.home.emptyDescription}
            href={site.github}
            linkLabel={copy.home.emptyLink}
          />
        )}
      </div>
    </div>
  </section>

  <section class="section site-container">
    <div class="developer-panel" data-reveal>
      <div class="developer-visual" aria-hidden="true">
        <span class="developer-monogram">Z</span>
      </div>
      <div class="developer-copy">
        <p class="eyebrow">{copy.home.developerEyebrow}</p>
        <h2>
          {copy.home.developerTitle1}
          <br />
          {copy.home.developerTitle2}
        </h2>
        <p>{copy.home.developerDescription}</p>
        <div class="developer-actions">
          <a class="button button-primary" href={localizePath('/about', lang)}>
            {copy.home.developerAbout}
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="text-link" href={site.blog} target="_blank" rel="noopener noreferrer">
            {copy.home.developerBlog}
            <Icon name="arrow-up-right" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .family-note {
    max-width: 460px;
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .family-strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-border);
  }
  .family-cell {
    position: relative;
    display: flex;
    min-height: 120px;
    flex-direction: column;
    padding: 0.8rem;
    overflow: hidden;
    background: var(--z-surface);
    transition: background 260ms ease;
  }
  .family-cell::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    content: '';
    background: var(--project-accent);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .family-cell:hover {
    background: var(--z-surface-raised);
  }
  .family-cell:hover::before {
    opacity: 1;
  }
  .family-cell-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .family-count {
    color: var(--z-text-muted);
    font-size: 0.7rem;
  }
  .family-name {
    padding-top: 0.7rem;
    font-size: 1.24rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .family-tagline {
    margin-top: 0.3rem;
    color: var(--z-text-muted);
    font-size: 0.75rem;
    line-height: 1.55;
  }
  .family-cell-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--z-text-muted);
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .bento-item {
    display: flex;
    min-width: 0;
  }
  .bento-item > :global(.project-card) {
    width: 100%;
    height: 100%;
  }
  .surface-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1.4rem, 2.6vw, 2.1rem);
    align-items: center;
    padding: clamp(1.1rem, 2.1vw, 1.7rem);
    border: 1px solid var(--z-border);
    border-radius: var(--z-radius);
    background: var(--z-surface);
  }
  .surface-intro h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
  }
  .surface-intro > p:not(.eyebrow) {
    max-width: 420px;
    margin: 0.55rem 0 0;
    color: var(--z-text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .surface-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 0.9rem;
    color: var(--z-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
  }
  .surface-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--z-primary);
  }
  .surface-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .surface-card {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.7rem;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: 2px;
    background: var(--z-surface-soft);
    transition:
      border-color 220ms ease,
      background 220ms ease;
  }
  .surface-card:hover {
    border-color: var(--z-border-strong);
    background: var(--z-surface-raised);
  }
  .surface-name-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.15rem;
  }
  .surface-arrow {
    color: var(--z-text-muted);
  }
  .surface-name {
    font-size: 1.02rem;
    font-weight: 580;
    letter-spacing: -0.02em;
  }
  .surface-domain {
    overflow: hidden;
    color: var(--z-text-muted);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .surface-state {
    margin-top: 0.55rem;
  }
  .surface-card :global(.status-badge) {
    font-size: 0.7rem;
  }
  .build-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1.6rem, 3vw, 2.75rem);
    align-items: start;
  }
  .build-intro {
    position: sticky;
    top: 5.25rem;
  }
  .build-intro h2 {
    margin: 0.45rem 0 0.65rem;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
  }
  .build-intro > p:not(.eyebrow) {
    max-width: 380px;
    margin: 0 0 1rem;
    color: var(--z-text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .build-note {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.1rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--z-border);
    color: var(--z-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }
  .build-note time {
    color: var(--z-text-secondary);
  }
  .log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--z-border);
    color: var(--z-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }
  .build-log :global(.activity-list) {
    border-bottom: 1px solid var(--z-border);
  }
  .build-log :global(.activity-item:first-child) {
    border-top: 0;
  }
  .build-log :global(.activity-item p) {
    max-width: 620px;
    font-size: 0.84rem;
    line-height: 1.65;
  }
  .developer-panel {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.4rem, 2.8vw, 2.5rem);
    align-items: center;
    padding: clamp(1.2rem, 2.3vw, 1.85rem);
    overflow: hidden;
    border: 1px solid var(--z-border-strong);
    border-radius: var(--z-radius);
    background: var(--z-surface);
  }
  .developer-visual {
    position: relative;
    display: grid;
    min-height: 176px;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--z-border);
    border-radius: 2px;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0 31px,
        color-mix(in srgb, var(--z-border) 70%, transparent) 31px 32px
      ),
      var(--z-surface-raised);
  }
  .developer-monogram {
    position: relative;
    z-index: 1;
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border-radius: 2px;
    background: var(--z-primary);
    color: #faf6ed;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
  }
  .developer-copy h2 {
    margin: 0.45rem 0 0.6rem;
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
  }
  .developer-copy > p:not(.eyebrow) {
    max-width: 560px;
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .developer-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (max-width: 1200px) {
    .bento-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 1120px) {
    .family-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 1000px) {
    .surface-panel {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .build-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .build-intro {
      position: static;
    }
    .build-note {
      display: none;
    }
    .developer-panel {
      grid-template-columns: 1fr;
    }
    .developer-visual {
      min-height: 150px;
    }
  }
  @media (max-width: 920px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .family-note {
      display: none;
    }
    .surface-grid {
      grid-template-columns: 1fr;
    }
    .developer-panel {
      padding: 1.25rem;
    }
    .developer-visual {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .family-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .family-cell {
      min-height: 112px;
      padding: 0.75rem;
    }
    .family-name {
      padding-top: 0.6rem;
      font-size: 1.16rem;
    }
    .family-tagline {
      font-size: 0.73rem;
    }
    .family-cell-foot {
      padding-top: 0.45rem;
    }
    .surface-panel {
      padding: 0.9rem;
    }
    .build-log :global(.activity-item) {
      padding-block: 0.7rem;
    }
    .developer-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
