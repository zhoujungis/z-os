---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
import { getCopy } from '../i18n/ui';
import { localizePath } from '../i18n';
import type { Lang } from '../types/domain';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = getCopy(lang);
---

<BaseLayout
  lang={lang}
  title={copy.pageTitles.notFound}
  description={copy.seo.notFoundDescription}
  noindex={true}
>
  <section class="not-found site-container">
    <div class="not-found-visual" aria-hidden="true">
      <span class="error-code">404</span>
    </div>
    <p class="eyebrow">{copy.notFound.eyebrow}</p>
    <h1>
      {copy.notFound.titleLine1}
      <br />
      <em>{copy.notFound.titleEm}</em>
    </h1>
    <p class="not-found-copy">{copy.notFound.copy}</p>
    <div class="not-found-actions">
      <a class="button button-primary" href={localizePath('/', lang)}>
        {copy.notFound.home}
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="button button-secondary" href={localizePath('/projects', lang)}>
        {' '}
        {copy.notFound.projects}{' '}
      </a>
      <a class="text-link" href={localizePath('/search', lang)}>
        {' '}
        {copy.notFound.search}{' '}
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    display: flex;
    min-height: 74vh;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding-block: 3.25rem;
    text-align: center;
  }
  .not-found-visual {
    position: relative;
    display: grid;
    width: 240px;
    height: 180px;
    place-items: center;
    margin-bottom: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--z-border-strong);
    border-radius: var(--z-radius);
    background: var(--z-surface);
  }
  .not-found-visual::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    content: '';
    background: var(--z-primary);
  }
  .not-found-visual::after {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    width: 0.4rem;
    height: 0.4rem;
    content: '';
    background: var(--z-primary);
  }
  .error-code {
    color: var(--z-primary);
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  h1 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  h1:lang(zh) {
    line-height: 1.16;
    letter-spacing: -0.015em;
  }
  h1 em {
    color: var(--z-primary);
    font-style: normal;
    font-weight: 600;
  }
  .not-found-copy {
    max-width: 460px;
    margin: 0;
    color: var(--z-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 480px) {
    .not-found {
      padding-block: 2.5rem;
    }
    .not-found-visual {
      width: 200px;
      height: 150px;
    }
    .error-code {
      font-size: 4.4rem;
    }
  }
</style>
