---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Seo from '../components/layout/Seo.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import CommandPalette from '../components/search/CommandPalette.vue';
import { getCopy } from '../i18n/ui';
import { htmlLang, localizePath } from '../i18n';
import type { Lang, SearchDocument } from '../types/domain';
interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
}
const props = Astro.props;
const copy = getCopy(props.lang);
const quickLinks: SearchDocument[] = [
  {
    id: 'quick-projects',
    type: 'page',
    title: copy.command.quickProjects,
    description: copy.command.quickProjectsDesc,
    url: localizePath('/projects', props.lang),
    tags: [],
  },
  {
    id: 'quick-tools',
    type: 'page',
    title: copy.command.quickTools,
    description: copy.command.quickToolsDesc,
    url: localizePath('/tools', props.lang),
    tags: [],
  },
  {
    id: 'quick-activity',
    type: 'page',
    title: copy.command.quickActivity,
    description: copy.command.quickActivityDesc,
    url: localizePath('/activity', props.lang),
    tags: [],
  },
  {
    id: 'quick-about',
    type: 'page',
    title: copy.command.quickAbout,
    description: copy.command.quickAboutDesc,
    url: localizePath('/about', props.lang),
    tags: [],
  },
];
const typeLabels = {
  project: copy.searchResults.typeProject,
  lab: copy.searchResults.typeLab,
  tool: copy.searchResults.typeTool,
  page: copy.searchResults.typePage,
  activity: copy.searchResults.typeActivity,
};
---

<!doctype html>
<html lang={htmlLang[props.lang]} data-theme="dark" data-lang={props.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#15130F" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        let theme;
        try {
          theme = localStorage.getItem('z-os-theme') === 'light' ? 'light' : 'dark';
        } catch {
          theme = 'dark';
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'light' ? '#F3EEE4' : '#15130F');
      })();
    </script>
    <Seo {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.header.skip}
    </a>
    <SiteHeader lang={props.lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={props.lang} />
    <CommandPalette
      client:only="vue"
      labels={copy.command}
      typeLabels={typeLabels}
      quickLinks={quickLinks}
      indexUrl={localizePath('/search-index.json', props.lang)}
    />
    <script is:inline>
      document
        .querySelectorAll('[data-command-open]')
        .forEach((button) =>
          button.addEventListener('click', () =>
            window.dispatchEvent(new CustomEvent('z:command-open')),
          ),
        );

      document.querySelectorAll('[data-language-switch]').forEach((link) => {
        const url = new URL(link.getAttribute('href'), location.href);
        url.search = location.search;
        url.hash = location.hash;
        link.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
      });

      document.querySelectorAll('[data-search-shortcut]').forEach((element) => {
        const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
        element.textContent = isMac ? '⌘ K' : 'Ctrl K';
      });

      (() => {
        const header = document.querySelector('[data-site-header]');
        const root = document.documentElement;
        let frame = 0;
        const update = () => {
          frame = 0;
          const max = root.scrollHeight - window.innerHeight;
          const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          root.style.setProperty('--scroll-progress', progress.toFixed(4));
          header?.classList.toggle('is-scrolled', window.scrollY > 10);
        };
        const schedule = () => {
          if (!frame) frame = window.requestAnimationFrame(update);
        };
        update();
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
      })();

      (() => {
        const items = document.querySelectorAll('[data-reveal]');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -4% 0px' },
        );
        items.forEach((item) => observer.observe(item));

        let frame = 0;
        const revealPassedItems = () => {
          frame = 0;
          const revealEdge = window.innerHeight + 120;
          for (const item of items) {
            if (
              !item.classList.contains('is-visible') &&
              item.getBoundingClientRect().top < revealEdge
            ) {
              item.classList.add('is-visible');
              observer.unobserve(item);
            }
          }
        };
        const scheduleReveal = () => {
          if (!frame) frame = window.requestAnimationFrame(revealPassedItems);
        };
        window.addEventListener('scroll', scheduleReveal, { passive: true });
      })();
    </script>
  </body>
</html>
